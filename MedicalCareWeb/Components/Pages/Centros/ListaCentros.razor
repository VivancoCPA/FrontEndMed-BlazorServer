@page "/centros"
@using MedicalCareWeb.Models.Centro

@* https://mudblazor.com/features/icons#icons *@

<MudContainer Fixed="true">
    @* ── KPI Cards ── *@
    <div style="
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
        margin-top: 8px;">

        <CardKpi AccentColor="#1E6FD9"
                 IconBg="rgba(30,111,217,.10)"
                 Icon="@Icons.Material.Filled.BusinessCenter"
                 Label="Total"
                 Value="@_total.ToString()"
                 Subtitle="Centros registrados" />

        <CardKpi AccentColor="#0E9E6E"
                 IconBg="rgba(14,158,110,.10)"
                 Icon="@Icons.Material.Filled.CheckCircle"
                 Label="Activos"
                 Value="@_activos.ToString()"
                 Subtitle="En operación" />

        <CardKpi AccentColor="#D94F3D"
                 IconBg="rgba(217,79,61,.10)"
                 Icon="@Icons.Material.Filled.RemoveCircle"
                 Label="Inactivos"
                 Value="@_inactivos.ToString()"
                 Subtitle="Fuera de operación" />

        <CardKpi AccentColor="#C07B1A"
                 IconBg="rgba(192,123,26,.10)"
                 Icon="@Icons.Material.Filled.Star"
                 Label="Más Visitado"
                 Value="@_masUsadaNombre"
                 Subtitle="@($"{_masVisitado} usos registrados")" />

    </div>

    <MudDataGrid T="CentroDto"
                 Dense="true"
                 @ref="grid"
                 Hover="true"
                 Elevation="3"
                 RowsPerPage="10"
                 Height="380px"
                 ServerData="LoadServerData"
                 Style="border-radius: 12px; overflow: hidden;">
        @* ── Spinner de carga ── *@
        <LoadingContent>
            <div class="d-flex flex-column align-center justify-center" style="height:200px; gap:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Cargando Centros Medicos...</MudText>
            </div>
        </LoadingContent>
        @* ── Barra de herramientas ── *@
        <ToolBarContent>
            <div class="d-flex align-center" style="gap:8px;">
                <MudIcon Icon="@Icons.Material.Filled.LocalHospital"
                         Color="Color.Primary"
                         Size="Size.Medium" />
                <MudText Typo="Typo.h6" Style="font-weight:700; letter-spacing:-.3px;">
                    Centros Medicos
                </MudText>
            </div>

            <MudSpacer />

            <MudTextField T="string"
                          Placeholder="Buscar Centro..."
                          ValueChanged="OnSearchChanged"
                          Adornment="Adornment.Start"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Style="min-width:240px;"
                          Class="mr-3" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddBusiness"
                       Style="border-radius:8px; font-weight:600; text-transform:none; font-size:13px;"
                       OnClick="NuevoCentro">
                Nuevo
            </MudButton>
        </ToolBarContent>
         @* ── Columnas ── *@
        <Columns>
            @* Nombre *@
            <PropertyColumn Property="x => x.Name"
                            HeaderStyle="@_HeaderStyle"
                            Title="Nombre"
                            Sortable="true"
                            CellStyle="width:350px;">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">
                        @context.Item.Name
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            @* Dirección *@
            <PropertyColumn Property="x => x.Address"
                            HeaderStyle="@_HeaderStyle"
                            Title="Dirección"
                            Sortable="false">
                <CellTemplate>
                    <div class="d-flex align-center" style="gap:4px;">
                        <MudIcon Icon="@Icons.Material.Outlined.LocationOn"
                                 Size="Size.Small"
                                 Color="Color.Info" />
                        <MudText Typo="Typo.body2">@context.Item.Address</MudText>
                    </div>
                </CellTemplate>
            </PropertyColumn>
            @* Type *@
            <PropertyColumn Property="x => x.TypeName"
                            HeaderStyle="@_HeaderStyle"
                            Title="Tipo"
                            Sortable="false"
                            CellStyle="width:145px;">
                <CellTemplate>
                    <div class="d-flex align-center" style="gap:4px;">
                        <MudIcon Icon="@Icons.Material.Outlined.LocalHospital"
                                 Size="Size.Small"
                                 Color="Color.Info" />
                        <MudText Typo="Typo.body2">@context.Item.TypeName</MudText>
                    </div>
                </CellTemplate>
            </PropertyColumn>
            @* Acciones *@
            <TemplateColumn Title="Acciones"
                            HeaderStyle="@_HeaderStyle"
                            Sortable="false"
                            CellStyle="width:130px;">
                <CellTemplate>
                    <div class="d-flex align-center" style="gap:2px;">
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => EditarTipo(context.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="@(context.Item.IsActive ? "Desactivar" : "Activar")">
                            <MudSwitch T="bool"
                                       Value="context.Item.IsActive"
                                       Color="Color.Success"
                                       UncheckedColor="Color.Error"
                                       Size="Size.Small"
                                       ValueChanged="@(async v => await Desactivar(context.Item))" />
                        </MudTooltip>
                        <MudChip T="string"
                                 Color="@(context.Item.IsActive ? Color.Success : Color.Error)"
                                 Size="Size.Small"
                                 Variant="Variant.Text">
                            @(context.Item.IsActive ? "Activo" : "Inactivo")
                        </MudChip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        @* ── Paginador ── *@
        <PagerContent>
            <MudDataGridPager T="CentroDto"
                              ShowPageSizeSelector="true"
                              PageSizeOptions="new int[] { 5, 10, 20, 50 }" />
        </PagerContent>
     </MudDataGrid>
</MudContainer>

@code {
    // ── KPI variables ──────────────────────────────────────────────────────────
    private int _total = 0;          // Total de aseguradoras registradas
    private int _activos = 0;          // Aseguradoras con IsActive = true
    private int _inactivos = 0;          // Aseguradoras con IsActive = false
    private int _masVisitado = 0;          // Cantidad de usos de la más frecuente
    private string _masUsadaNombre = "—";      // Nombre de la aseguradora más usada
    // ──────────────────────────────────────────────────────────────────────────
    private string? _searchString;
    private int? _lastPage;
    private int? _lastPageSize;
    private string? _lastSearch;
    private string? _lastColSort;
    private bool? _lastOrderSort;
    private string _HeaderStyle = "background-color: var(--mud-palette-primary) !important; color: white !important; font-weight: bold; height: 40px;";
    //
    private MudDataGrid<CentroDto>? grid;
    private CancellationTokenSource? _cts;


    private async void NuevoCentro()
    {
        UpdateCentroRequestDto centro = new();
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            FullWidth = true,
            Position = DialogPosition.CenterRight
        };

        var parameter = new DialogParameters
        {
            { "modelo" , centro},
            { "EsEdicion", false }
        };
        var dialog = await DialogService.ShowAsync<DataEntryCentro>("Registrar Nueva Centro Medico", parameter, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            // refresca tu lista de centros
            await CargarDatos();
        }
    }
    //
    private async void EditarTipo(CentroDto item)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            FullWidth = true,
            Position = DialogPosition.CenterRight
        };

        var parameter = new DialogParameters
        {
            //clonamos para no modificar el original hasta que se guarde
            { "Modelo", new UpdateCentroRequestDto
                {
                    Id = item.Id,
                    Name = item.Name,
                    Address = item.Address,
                    TypeId = item.TypeId,
                    Phone = item.Phone,
                    Latitude = item.Latitude,
                    Longitude = item.Longitude,
                    IsActive = item.IsActive
                }
            },
            { "EsEdicion", true }
        };
        //
        var dialog = await DialogService.ShowAsync<DataEntryCentro>("Editar Centro Medico", parameter, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            await CargarDatos();
        }
    }
    //
    private async Task Desactivar(CentroDto tipo)
    {
        //Configurar el cuadro de diálogo
        var options = new DialogOptions { CloseOnEscapeKey = true, Position = DialogPosition.TopCenter, CloseButton = true };
        bool? result = await DialogService.ShowMessageBoxAsync(
            @tipo.IsActive ? "Confirmar Desactivacion" : "Confirmar Activacion",
            $"¿Estás seguro de que deseas {(tipo.IsActive ? "Desactivar" : "Activar")} Centro: {tipo.Name}?",
            yesText: @tipo.IsActive ? "Desactivar" : "Activar",
            cancelText: "Cancelar",
            options: options
        );

        if (result == true)
        {
            // Llamar a la API para eliminar el centro
            var response = await CentroService.ToggleAseguradoraAsync(tipo.Id);
            if (!response.Success)
            {
                Snackbar.Add(response.ErrorMessage!, Severity.Error);

            }
            else
            {
                // API exitosa — confirmar el nuevo valor
                Snackbar.Add($"Centro {tipo.Name} actualizado.", Severity.Success);
            }
            // refresca tu lista de centros
        }
        await CargarDatos();
    }
    //

        
    private async Task OnSearchChanged(string value)
    {
        // Lógica de búsqueda aquí
        if (grid is null)
            return; // 👈 evita crash

        _cts?.Cancel(); // cancela llamada anterior
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, _cts.Token); // ⏱ espera (ajustable)
            //Console.WriteLine($"Search changed: {value}");
            _searchString = value;
            grid.NavigateTo(0); // 👈 vuelve a página 1
            await grid.ReloadServerData(); // 🔥 dispara el filtro en backend = LoadServerData
        }
        catch (TaskCanceledException)
        {
            // normal: usuario sigue escribiendo
        }
    }
    //
    
    private async Task<GridData<CentroDto>>
            LoadServerData(GridState<CentroDto> state, CancellationToken ct)
    {
        //await Task.Delay(1000);//

        var sort = state.SortDefinitions.FirstOrDefault();

        if (_lastPage == state.Page &&
            _lastPageSize == state.PageSize &&
            _lastSearch == _searchString &&
            _lastColSort == sort?.SortBy &&
            _lastOrderSort == sort?.Descending
        )
        {
            return new GridData<CentroDto>(); // evita duplicado
        }
        _lastPage = state.Page;
        _lastPageSize = state.PageSize;
        _lastSearch = _searchString;
        _lastColSort = sort?.SortBy;
        _lastOrderSort = sort?.Descending;
        // ⚠️ Mud usa Page 0-based → tu API usa 1-based
        var page = state.Page + 1;
        var paramters = new ListedPagedDto
            (
             Page: page,
             PageSize: state.PageSize,
             Search: _searchString,
             SortBy: sort?.SortBy,
             SortDesc: sort?.Descending ?? false
            );

        var response = await CentroService.GetCentroPaged(paramters);

        if (!response.Success)
        {
            Snackbar.Add(response.ErrorMessage!, Severity.Error);
        }

        if (response.Items is null)
        {
            return new GridData<CentroDto>
            {
                Items = [],
                TotalItems = 0
            };
        }
            ;

        return new GridData<CentroDto>// mapea tu respuesta al formato que espera MudDataGrid
        {
            Items = response.Items,
            TotalItems = response.TotalCount
        };
    }
    private async Task CargarDatos()
    {
        await InvokeAsync(async () =>
        {
            if (grid is not null)
            {
                _lastPage = null; //asegurar que se recarga para que pase la validacion inicial
                grid.NavigateTo(0);              // sync
                await grid.ReloadServerData();   // async
                StateHasChanged();
            }
        });
    }
}
