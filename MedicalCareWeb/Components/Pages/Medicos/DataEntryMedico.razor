@using MedicalCareWeb.Enum
@using MedicalCareWeb.Models.Centro
@using MedicalCareWeb.Models.Medico
@using MedicalCareWeb.Models.TipoEspecialidad
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations

<MudForm @ref="_form" Model="@doctorFormModel">
    <div class="dea-shell">
        <div class="dea-tabs-shell">
        <MudTabs Elevation="0" Rounded="true">
            <MudTabPanel Text="Datos del medico" Icon="@Icons.Material.Filled.Person">
                <div class="dea-tab-pane">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="8">
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudPaper Outlined="true" Class="pa-4 dea-section-card">
                                    <div class="dea-section-label">
                                        <MudIcon Icon="@Icons.Material.Filled.Badge" Style="font-size:14px; color:var(--mud-palette-primary);" />
                                        Informacion personal
                                    </div>
                                    <MudGrid Spacing="2" Class="mt-1">
                                        <MudItem xs="12" sm="12">
                                            <MudTextField T="string" @bind-Value="doctorFormModel.name" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Required="true" RequiredError="El nombre es obligatorio" />
                                        </MudItem>
                                        <MudItem xs="12" sm="12">
                                            <MudTextField T="string" @bind-Value="doctorFormModel.lastName" Label="Apellido" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Required="true" RequiredError="El apellido es obligatorio" />
                                        </MudItem>
                                        <MudItem xs="12" sm="7">
                                            <MudSelect T="string" @bind-Value="doctorFormModel.SpecialtyName" Label="Especialidad" Placeholder="Seleccione Especialidad" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Required="true" RequiredError="La especialidad es obligatoria">
                                                @foreach (var specialty in specialtyOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@specialty.Id.ToString()">@specialty.name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="5">
                                            <MudTextField T="string" @bind-Value="doctorFormModel.register" Label="Numero de registro" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Required="true" RequiredError="El numero de registro es obligatorio" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12">
                                <MudPaper Outlined="true" Class="pa-4 dea-section-card">
                                    <div class="dea-section-label">
                                        <MudIcon Icon="@Icons.Material.Filled.ContactPhone" Style="font-size:14px; color:var(--mud-palette-primary);" />
                                        Contacto y medios
                                    </div>
                                    <MudGrid Spacing="2" Class="mt-1">
                                        <MudItem xs="12" sm="12">
                                            <MudTextField T="string" @bind-Value="doctorFormModel.email" 
                                                    Adornment="Adornment.Start"
                                                    AdornmentIcon="@Icons.Material.Outlined.Email"
                                                    Label="Correo" 
                                                    Variant="Variant.Outlined" 
                                                    Margin="Margin.Dense" 
                                                    FullWidth="true" 
                                                    Required="true" 
                                                    RequiredError="El correo es obligatorio" 
                                                    Validation="@(new EmailAddressAttribute { ErrorMessage = "Ingrese un correo valido" })" />
                                        </MudItem>
                                        <MudItem xs="12" sm="7">
                                            <MudTextField T="string" @bind-Value="doctorFormModel.phone" 
                                                    Adornment="Adornment.Start" 
                                                    AdornmentIcon="@Icons.Material.Outlined.Phone" 
                                                    Label="Telefono" 
                                                    Variant="Variant.Outlined" 
                                                    Margin="Margin.Dense" 
                                                    FullWidth="true" 
                                                    Required="true" 
                                                    RequiredError="El telefono es obligatorio" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudPaper Outlined="true" Class="pa-4 dea-preview-card">
                                    <div class="dea-section-label">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Style="font-size:14px; color:var(--mud-palette-primary);" />
                                        Foto y vista previa
                                    </div>
                                    <div class="dea-preview-grid mt-2">
                                        <div class="dea-preview-upload">
                                            <InputImg Label="Foto del medico" ImagenURL="@doctorFormModel.photoUrl" ImagenSeleccionada="OnImagenSeleccionada" />
                                        </div>
                                        <div class="dea-preview-meta">
                                            <MudText Typo="Typo.caption">@GetProfileStateText()</MudText>
                                            <MudText Typo="Typo.h6">@GetDoctorDisplayName()</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@GetDoctorPreviewSubtitle()</MudText>
                                        </div>
                                    </div>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12">
                                <MudPaper Outlined="true" Class="pa-4 dea-section-card">
                                    <div class="dea-section-label">
                                        <MudIcon Icon="@Icons.Material.Filled.Settings" Style="font-size:14px; color:var(--mud-palette-primary);" />
                                        Configuracion
                                    </div>

                                    <MudPaper Outlined="true" Class="pa-3 mb-2 mt-2">
                                        <div class="d-flex justify-space-between align-center gap-3">
                                           @*  <div>
                                                <MudText Typo="Typo.subtitle2">Activo</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Habilitar en el sistema</MudText>
                                            </div>
                                            <MudSwitch T="bool" @bind-Value="doctorFormModel.isActive" Color="Color.Primary" /> *@
                                                    <div class="dea-status-pill @(doctorFormModel.isActive ? "dea-active" : "dea-inactive")">
                                                        <MudSwitch T="bool"
                                                                   @bind-Value="doctorFormModel.isActive"
                                                                   Color="Color.Success"
                                                                   UncheckedColor="Color.Error"
                                                                   Size="Size.Small" />
                                                        <span>@(doctorFormModel.isActive ? "Activo" : "Inactivo")</span>
                                                    </div>
                                        </div>
                                    </MudPaper>

                                    <MudPaper Outlined="true" Class="pa-3">
                                        <div class="d-flex justify-space-between align-center gap-3">
                                            @* <div>
                                                <MudText Typo="Typo.subtitle2">Veterinario</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Atencion de mascotas</MudText>
                                            </div>
                                            <MudSwitch T="bool" @bind-Value="doctorFormModel.isVet" Color="Color.Primary" /> *@
                                                    <div class="dea-status-pill @(doctorFormModel.isVet ? "dea-active" : "dea-inactive")">
                                                        <MudSwitch T="bool" 
                                                                   @bind-Value="doctorFormModel.isVet"
                                                                   Color="Color.Success"
                                                                   UncheckedColor="Color.Error"
                                                                   Size="Size.Small" />
                                                        <span>Veterinario</span>
                                                    </div>
                                        </div>
                                    </MudPaper>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Asociacion de centros" Icon="@Icons.Material.Filled.LocalHospital">
                <div class="dea-tab-pane dea-tab-pane-scroll">
                <MudPaper Outlined="true" Class="pa-4 dea-section-card">
                    <div class="dea-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Style="font-size:14px; color:var(--mud-palette-primary);" />
                        Centros vinculados (@doctorFormModel.Centers.Count)
                    </div>

                    @if (doctorFormModel.Centers.Count > 0)
                    {
                        @foreach (var center in doctorFormModel.Centers)
                        {
                            <MudPaper Outlined="true" Class="pa-3 mb-2 mt-2">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">@center.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Centro vinculado</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudTextField T="string" @bind-Value="center.OfficeNumber" Label="Oficina" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudTextField T="string" @bind-Value="center.WorkSchedule" Label="Horario" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="1" Class="d-flex justify-end">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RemoveCenter(center))" />
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    }

                    <MudText Typo="Typo.body2" Class="mb-2 mt-2">Vincular nuevo centro</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="9">
                                    <MudSelect T="CentroDto" @bind-Value="selectedCenterObject" Label="Buscar centro" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                @foreach (var centerOption in availableCenters)
                                {
                                            <MudSelectItem T="CentroDto" Value="@centerOption">@centerOption.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3" Class="d-flex justify-end">
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       StartIcon="@Icons.Material.Filled.Add" 
                                       OnClick="AddSelectedCenter"                                            
                                       Style="font-weight:600; text-transform:none; border-radius:8px; min-width:130px;"
                                       >
                                Añadir
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        Configure los detalles especificos para cada ubicacion vinculada.
                    </MudText>
                </MudPaper>
                </div>
            </MudTabPanel>
        </MudTabs>
        </div>

        <div class="dea-actions pa-2">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       OnClick="Cancel"
                       Style="font-weight:600; text-transform:none;">
                Cancelar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@(EsEdicion ? Icons.Material.Filled.Save : Icons.Material.Filled.Add)"
                       OnClick="Submit"
                       Style="font-weight:600; text-transform:none; border-radius:8px; min-width:130px;">
                @(EsEdicion ? "Actualizar" : "Registrar")
            </MudButton>
        </div>
    </div>
</MudForm>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired]
    public UpdateMedicoRequestDto doctorFormModel { get; set; } = new();

    [Parameter]
    public UpdateMedicoRequestDto? Modelo { get; set; }

    [Parameter]
    public bool EsEdicion { get; set; }

    private MudForm? _form;
    // private string selectedCenter = string.Empty;

    private IEnumerable<TipoEspecialidadDto> specialtyOptions = [];
    private IEnumerable<CentroDto> availableCenters = [];
    CentroDto? selectedCenterObject;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    protected override void OnParametersSet()
    {
        if (Modelo is not null)
        {
            doctorFormModel = Modelo;
        }

        doctorFormModel.Centers ??= [];
    }

    private async Task Submit()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            Snackbar.Add("Por favor completa los campos obligatorios.", Severity.Warning);
            return;
        }

        MudDialog?.Close(DialogResult.Ok(doctorFormModel));
    }

    private void Cancel() => MudDialog?.Cancel();

    private Task OnImagenSeleccionada(IBrowserFile archivo)
    {
        doctorFormModel.FotoArchivo = archivo;
        return Task.CompletedTask;
    }

    private string GetDoctorDisplayName()
    {
        var fullName = $"{doctorFormModel.name} {doctorFormModel.lastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "Vista del medico" : fullName;
    }

    private string GetDoctorPreviewSubtitle()
    {
        var specialty = string.IsNullOrWhiteSpace(doctorFormModel.SpecialtyName)
            ? "Sin especialidad"
            : doctorFormModel.SpecialtyName;
        var registration = string.IsNullOrWhiteSpace(doctorFormModel.register)
            ? "Registro pendiente"
            : doctorFormModel.register;
        return $"{specialty} - {registration}";
    }

    private string GetProfileStateText()
    {
        return doctorFormModel.isActive ? "Perfil activo" : "Perfil inactivo";
    }

    private void RemoveCenter(MedicoCentroAfiliadoDto center)
    {
        doctorFormModel.Centers.Remove(center);
    }

    private void AddSelectedCenter()
    {
        if (selectedCenterObject is null)
        {
            return;
        }

        if (doctorFormModel.Centers.Any(x => x.Id == selectedCenterObject.Id))
        {
            selectedCenterObject = null;
            Snackbar.Add("El centro ya fue agregado.", Severity.Info);
            return;
        }

        doctorFormModel.Centers.Add(new MedicoCentroAfiliadoDto
        {
            
            Id = selectedCenterObject.Id,
            Name = selectedCenterObject.Name

        });

        selectedCenterObject = null;
    }

    private async Task Load()
    {
        specialtyOptions = await TipoEspecialidadService.GetAllTipoEspecialidadAsync(EnumStatus.Activo);
        availableCenters = await CentroService.GetAllCentrosAsync(EnumStatus.Activo);
    }
}
