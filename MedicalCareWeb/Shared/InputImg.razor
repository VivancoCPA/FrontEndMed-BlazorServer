@* ══════════════════════════════════════════
   InputImg.razor  –  Logo Upload
   ══════════════════════════════════════════ *@

<InputFile id="@_id" OnChange="OnChange"
           accept=".jpg,.jpeg,.png,.svg,.webp"
           style="display:none;" />

<label for="@_id" class="iimg-upload-zone @(_hasFile ? "iimg-has-file" : "")"
       title="@Label" style="cursor:pointer; display:block;">

    @if (_cargando)
    {
        <div class="iimg-loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        </div>
    }
    else if (!string.IsNullOrEmpty(_previewSrc))
    {
        <div class="iimg-img-wrap iimg-reveal">
            <img src="@_previewSrc" class="iimg-preview-img" alt="Logo preview" />
            <div class="iimg-overlay">
                <span class="iimg-overlay-icon">✎</span>
                <span class="iimg-overlay-text">Cambiar</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ImagenURL))
    {
        <div class="iimg-img-wrap iimg-reveal">
            <img src="@ImagenURL" class="iimg-preview-img" alt="Logo actual" />
            <div class="iimg-overlay">
                <span class="iimg-overlay-icon">✎</span>
                <span class="iimg-overlay-text">Cambiar</span>
            </div>
        </div>
    }
    else
    {
        <div class="iimg-empty">
            <div class="iimg-empty-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="3" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="m21 15-5-5L5 21" />
                </svg>
            </div>
            <span class="iimg-empty-label">@Label</span>
            <span class="iimg-empty-hint">PNG · JPG · SVG</span>
        </div>
    }

</label>

@code {
    [Parameter] public string Label { get; set; } = "Seleccionar Logo";
    [Parameter] public string? ImagenURL { get; set; }
    [Parameter] public EventCallback<IBrowserFile> ImagenSeleccionada { get; set; }
    [Parameter] public long MaxBytes { get; set; } = 2 * 1024 * 1024;

    private readonly string _id = $"iimg-{Guid.NewGuid():N}";
    private string? _previewSrc;
    private bool _hasFile;
    private bool _cargando;

    private async Task OnChange(InputFileChangeEventArgs e)
    {
        _cargando = true;
        _previewSrc = null;
        _hasFile = false;
        ImagenURL = null;
        StateHasChanged();

        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: MaxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var mime = file.ContentType is { Length: > 0 } ct ? ct : "image/png";
            _previewSrc = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
            _hasFile = true;

            await ImagenSeleccionada.InvokeAsync(file);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[InputImg] {ex.Message}");
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }
}
